# ============================================================
# Prospecting Engine — Environment Variables
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Validate with:
#   npm run validate
# ============================================================

# ── Supabase (REQUIRED) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DB_PASSWORD=postgres  # Only needed for direct DB migration

# ── Dashboard (browser-side) ─────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Claude API (RECOMMENDED) ─────────────────────────────────
# Powers: content generation, personalization, SEO articles, social posts
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Email — Transactional (Resend) ───────────────────────────
# Powers: lead magnet delivery, nurture sequence emails
RESEND_API_KEY=re_your_api_key

# ── Email — Cold Outreach (Instantly.ai) ─────────────────────
# Powers: cold campaigns, domain warmup
INSTANTLY_API_KEY=your-instantly-api-key

# ── Email — Nurture Automation (Loops.so) ────────────────────
LOOPS_API_KEY=your-loops-api-key

# ── Enrichment ───────────────────────────────────────────────
HUNTER_API_KEY=your-hunter-api-key
CLEARBIT_API_KEY=your-clearbit-api-key
CLAY_API_KEY=your-clay-api-key

# ── Prospect Discovery ───────────────────────────────────────
GITHUB_TOKEN=your-github-token

# ── Content Cross-Posting ────────────────────────────────────
DEV_TO_API_KEY=your-devto-api-key
MEDIUM_TOKEN=your-medium-token
MEDIUM_USER_ID=your-medium-user-id
HASHNODE_TOKEN=your-hashnode-token
HASHNODE_PUBLICATION_ID=your-hashnode-publication-id

# ── Blog Publishing (Ghost CMS) ─────────────────────────────
GHOST_API_URL=https://your-ghost-instance.com
GHOST_ADMIN_API_KEY=your-ghost-admin-key

# ── Analytics (PostHog) ──────────────────────────────────────
POSTHOG_API_KEY=your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# ── Job Scheduling (Trigger.dev) ─────────────────────────────
TRIGGER_DEV_API_KEY=your-trigger-dev-key
