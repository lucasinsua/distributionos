---
import Landing from '../layouts/Landing.astro';
---

<Landing title="Thank You!" description="Check your inbox for your free resource">
  <main class="landing">
    <section class="hero">
      <h1>You're In!</h1>
      <p class="subheadline">
        Check your inbox — your free resource is on its way.
        If you don't see it in the next few minutes, check your spam folder.
      </p>
    </section>

    <section>
      <h2>What happens next?</h2>
      <ul style="list-style: none; padding: 0;">
        <li style="padding: 0.5rem 0;">1. Check your email for the first delivery</li>
        <li style="padding: 0.5rem 0;">2. Set aside 10 minutes to go through it</li>
        <li style="padding: 0.5rem 0;">3. Reply to any email if you have questions — we read every one</li>
      </ul>
    </section>
  </main>
</Landing>
