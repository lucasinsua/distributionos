{
  "name": "prospecting-engine",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:migrate": "turbo db:migrate --filter=@prospecting-engine/shared",
    "validate": "node scripts/validate-env.mjs",
    "seed": "node scripts/seed.mjs",
    "pipeline": "node scripts/run-pipeline.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:landing": "bash scripts/deploy.sh landing",
    "deploy:dashboard": "bash scripts/deploy.sh dashboard",
    "deploy:mcp": "bash scripts/deploy.sh mcp",
    "deploy:migrate": "bash scripts/deploy.sh migrate",
    "deploy:jobs": "bash scripts/deploy.sh jobs",
    "dashboard": "npm run dev --workspace=@prospecting-engine/dashboard",
    "landing": "npm run dev --workspace=@prospecting-engine/landing-pages"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
